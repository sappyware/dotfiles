# roselock config — hot-reloaded on save
[wallpaper]
# "screenshot_blur" | "file" | "shader"
mode = "f"
screenshot_blur = 1
glass_blur = 1.0
shader = "topo"
shader_fps = 30
file = ""

[ui]
use24h = true
dim = 0.14
show_wifi = true
show_battery_percent = false
user_family = ""
display_name = ""

[transition]
# "screenshot" (fade to grim screenshot) | "live" (fade to transparent)
mode = "screenshot"
fade_ms = 700
