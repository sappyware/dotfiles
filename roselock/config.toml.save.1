# roselock config — hot-reloaded on save
[wallpaper]
# "screenshot_blur" | "file" | "shader"
mode = "shader"
screenshot_blur = 1
glass_blur = 1.0
shader = "topo"
shader_fps = 30
file = "/home/arya/Pictures/Wallpapers/city-on-water.jpg"

[ui]
use24h = true1
dim = 0.14
show_wifi = true
show_battery_percent = false
user_family = ""
display_name = "Skibidi"

[transition]
# "screenshot" (fade to grim screenshot) | "live" (fade to transparent)
mode = "screenshot"
fade_ms = 700
